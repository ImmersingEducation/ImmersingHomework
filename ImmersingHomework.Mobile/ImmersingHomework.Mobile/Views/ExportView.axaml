<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImmersingHomework.Mobile.Views.ExportView">
    <StackPanel Orientation="Vertical" Spacing="16" Margin="16">
        <TextBlock x:Name="HomeworkDateTextBlock" FontSize="24"/>
        <TextBlock FontSize="16">已成功识别作业。</TextBlock>
        <Button x:Name="ExportImageButton" HorizontalAlignment="Stretch" Height="48" Click="OnExportImageClicked">导出为图片</Button>
        <Button x:Name="ExportPdfButton" HorizontalAlignment="Stretch" Height="48" Click="OnExportPdfClicked">导出为 PDF</Button>
        <Button HorizontalAlignment="Stretch" Height="48" Click="OnBackClicked">返回</Button>
        <TextBlock x:Name="StatusText" FontSize="14" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
