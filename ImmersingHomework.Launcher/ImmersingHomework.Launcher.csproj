<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Launcher</AssemblyName>
        <AssemblyVersion>0.2.0.0</AssemblyVersion>
        <FileVersion>0.2.0.0</FileVersion>
        <Version>0.2.0.0</Version>
        <Company>ImmersingEducation</Company>
        <CompanyRDNS>com.immersingeducation</CompanyRDNS>
        <Authors>ImmersingEducation</Authors>
        <Summary>班级大屏作业板（ImmersingHomework）</Summary>
        <Description>一个现代化的班级大屏作业板应用，使用 Avalonia UI 开发，面向教室场景记录与分发作业。</Description>
        <Copyright>Copyright © 2026 ImmersingEducation</Copyright>
        <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/cc-cpstudio/ImmersingHomework</RepositoryUrl>
        <PackageTags>homework;education;classroom;avalonia</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../ImmersingHomework/ImmersingHomework.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false" />
    </ItemGroup>

    <Target Name="CopyMainApp" AfterTargets="Build">
        <PropertyGroup>
            <MainAppOutput>$(MSBuildThisFileDirectory)..\ImmersingHomework\bin\$(Configuration)\net10.0\</MainAppOutput>
        </PropertyGroup>
        <RemoveDir Directories="$(OutDir)ImmersingHomework" />
        <ItemGroup>
            <MainAppFiles Include="$(MainAppOutput)**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(MainAppFiles)"
              DestinationFiles="@(MainAppFiles->'$(OutDir)ImmersingHomework\%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>

</Project>
