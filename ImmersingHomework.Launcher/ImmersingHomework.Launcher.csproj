<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Launcher</AssemblyName>
        <AssemblyVersion>0.2.0.0</AssemblyVersion>
        <FileVersion>0.2.0.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../ImmersingHomework/ImmersingHomework.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false" />
    </ItemGroup>

    <PropertyGroup>
        <!-- 主工程输出目录：带 -r/自包含 发布时产物位于 net10.0/<RuntimeIdentifier> 子目录 -->
        <MainProjectBaseDir>$(MSBuildProjectDirectory)/../ImmersingHomework/bin/$(Configuration)/net10.0</MainProjectBaseDir>
        <MainProjectOutputDir>$(MainProjectBaseDir)</MainProjectOutputDir>
        <MainProjectOutputDir Condition="'$(RuntimeIdentifier)' != '' and Exists('$(MainProjectBaseDir)/$(RuntimeIdentifier)')">$(MainProjectBaseDir)/$(RuntimeIdentifier)</MainProjectOutputDir>
    </PropertyGroup>

    <Target Name="StageMainProjectOutput" AfterTargets="Build">
        <ItemGroup>
            <MainProjectFiles Include="$(MainProjectOutputDir)/**/*"
                              Exclude="$(MainProjectOutputDir)/Data/**;$(MainProjectOutputDir)/Logs/**;$(MainProjectOutputDir)/Outputs/**;$(MainProjectOutputDir)/Temp/**;$(MainProjectOutputDir)/win-x64/**;$(MainProjectOutputDir)/publish/**" />
        </ItemGroup>
        <Copy SourceFiles="@(MainProjectFiles)"
              DestinationFolder="$(OutDir)ImmersingHomework/%(RecursiveDir)"
              SkipUnchangedFiles="true" />
        <MakeDir Directories="$(OutDir)Data;$(OutDir)Outputs;$(OutDir)Logs;$(OutDir)Update" />
    </Target>

</Project>
