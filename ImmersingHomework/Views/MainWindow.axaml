<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:controls="clr-namespace:ImmersingHomework.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ImmersingHomework.Views.MainWindow"
        Title="方圆作业板" Background="#ECECEC"
        Icon="avares://ImmersingHomework/Assets/icon.png"
        RequestedThemeVariant="Light">
        <Grid RowDefinitions="Auto,*,Auto" Margin="16">
                <TextBlock x:Name="Hitokoto" Grid.Row="0" FontSize="24" Foreground="#AEAEAE" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 8"/>
                <controls:HomeworkPanel x:Name="HomeworkPanel" Grid.Row="1"/>
                <Grid Grid.Row="2" RowDefinitions="*" ColumnDefinitions="*,Auto,*">
                        <Button Grid.Column="0" x:Name="MinimizeButton" Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Left" Click="MinimizeButton_OnClick">
                                <fa:FASymbolIcon Symbol="FullScreenMinimize" FontSize="24"/>
                        </Button>
                        <Border Grid.Column="1" Background="#FFFFFFFF" CornerRadius="30">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="AddHomeworkButton" Width="60" Height="60" CornerRadius="30" Background="Transparent" BorderBrush="Transparent" Click="AddHomeworkButton_OnClick">
                                                <fa:FASymbolIcon Symbol="Add" FontSize="24"/>
                                        </Button>
                                        <Button x:Name="FreezeButton" Width="60" Height="60" CornerRadius="30" Background="Transparent" BorderBrush="Transparent" Click="FreezeButton_OnClick">
                                                <fa:FASymbolIcon Symbol="WeatherSnowflake" FontSize="24"/>
                                        </Button>
                                        <Button x:Name="RestoreButton" Width="60" Height="60" CornerRadius="30" Background="Transparent" BorderBrush="Transparent" Click="RestoreButton_OnClick">
                                                <fa:FASymbolIcon Symbol="Restore" FontSize="24"/>
                                        </Button>
                                        <Button Width="60" Height="60" CornerRadius="30" Background="Transparent" BorderBrush="Transparent" Click="ShareButton_OnClick">
                                                <fa:FASymbolIcon Symbol="Share" FontSize="24"/>
                                        </Button>
                                </StackPanel>
                        </Border>
                        <Button Grid.Column="2" x:Name="DateButton" Width="90" Height="60" CornerRadius="30" HorizontalAlignment="Right" Click="DateButton_OnClick">
                                <TextBlock x:Name="DateText"></TextBlock>
                        </Button>
                        <Popup x:Name="CalendarPopup"
                               Placement="Bottom"
                               IsLightDismissEnabled="True"
                               HorizontalOffset="-10"
                               VerticalOffset="-10"
                               IsOpen="False">
                                <Calendar x:Name="Calendar" SelectionMode="SingleDate" SelectedDatesChanged="Calendar_OnSelectedDatesChanged"/>
                        </Popup>
                </Grid>
        </Grid>
</Window>
