<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:controls="clr-namespace:ImmersingHomework.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="ImmersingHomework.Views.MainWindow"
        Title="方圆作业板" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
        Icon="avares://ImmersingHomework/Assets/icon.png">
        <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" HorizontalAlignment="Stretch" Height="96">
                        <StackPanel Orientation="Horizontal" Margin="16 8">
                                <TextBlock x:Name="DateTextBlock" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="32" FontWeight="Bold"/>
                                <TextBlock x:Name="PanelTitleTextBlock" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </StackPanel>
                </Border>
                <!-- 底部不留外边距，作业面板一直延伸到窗口下边缘 -->
                <Grid Grid.Row="1" Margin="16,16,16,0">
                <Grid>
                        <!-- 作业内容宿主：主面板与时光机预览面板叠放在一起，
                             切换快照时两个面板一前一后横向滑动，宿主负责裁剪。 -->
                        <Grid x:Name="HomeworkContentHost" ClipToBounds="True">
                                <controls:HomeworkPanel x:Name="HomeworkPanel"/>
                                <!-- 快照/作业异步加载时的等待提示，覆盖在作业内容之上 -->
                                <Panel x:Name="HomeworkLoadingOverlay"
                                       ZIndex="20"
                                       IsVisible="False"
                                       IsHitTestVisible="False"
                                       Background="#33000000">
                                        <Border HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ContentDialogBackground}"
                                                BorderBrush="{DynamicResource ContentDialogBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="28,22"
                                                BoxShadow="0 8 24 0 #33000000">
                                                <StackPanel Spacing="14" HorizontalAlignment="Center">
                                                        <fa:FAProgressRing x:Name="HomeworkLoadingRing"
                                                                           Width="48" Height="48"
                                                                           HorizontalAlignment="Center"
                                                                           IsIndeterminate="True"
                                                                           IsActive="False"/>
                                                        <TextBlock Text="正在加载，请稍候…"
                                                                   HorizontalAlignment="Center"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                        </Border>
                                </Panel>
                        </Grid>
                        <!-- 按钮栏悬浮于作业面板之上，不占用布局行；保留 16 的底部外边距，位置与原来保持一致 -->
                        <Grid x:Name="ButtonBar" VerticalAlignment="Bottom" Margin="0,0,0,16" RowDefinitions="*" ColumnDefinitions="*,Auto,*">
                                <Button Grid.Column="0" x:Name="MinimizeButton" Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Left" Click="MinimizeButton_OnClick">
                                        <fa:FASymbolIcon Symbol="FullScreenMinimize" FontSize="24"/>
                                </Button>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                        <Grid Width="60" Height="60">
                                                <Button x:Name="FreezeButton" Width="60" Height="60" CornerRadius="30" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="Transparent" Click="FreezeButton_OnClick">
                                                        <fa:FASymbolIcon Symbol="WeatherSnowflake" FontSize="24"/>
                                                </Button>
                                                <!-- 冻结时长按解冻的进度环：控件比按钮大，通过负 Margin 抵消布局占用，
                                                     实际绘制的圆环位于按钮外圈 -->
                                                <fa:FAProgressRing x:Name="FreezeProgressRing"
                                                                   Width="96" Height="96" Margin="-18"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Minimum="0" Maximum="100" Value="0"
                                                                   IsIndeterminate="False" IsActive="False"
                                                                   IsHitTestVisible="False"/>
                                        </Grid>
                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="30">
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                        <Button x:Name="AddHomeworkButton" Width="60" Height="60" CornerRadius="30" Background="Transparent" BorderBrush="Transparent" Click="AddHomeworkButton_OnClick">
                                                                <fa:FASymbolIcon Symbol="Add" FontSize="24"/>
                                                        </Button>
                                                        <Button x:Name="RestoreButton" Width="60" Height="60" CornerRadius="30" Background="Transparent" BorderBrush="Transparent" Click="RestoreButton_OnClick">
                                                                <fa:FASymbolIcon Symbol="Restore" FontSize="24"/>
                                                        </Button>
                                                        <Button Width="60" Height="60" CornerRadius="30" Background="Transparent" BorderBrush="Transparent" Click="ShareButton_OnClick">
                                                                <fa:FASymbolIcon Symbol="Share" FontSize="24"/>
                                                        </Button>
                                                </StackPanel>
                                        </Border>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="DateButton" Width="90" Height="60" CornerRadius="30" HorizontalAlignment="Right" Click="DateButton_OnClick">
                                        <TextBlock x:Name="DateText"></TextBlock>
                                </Button>
                                <Popup x:Name="CalendarPopup"
                                        Placement="Bottom"
                                        IsLightDismissEnabled="True"
                                        HorizontalOffset="-10"
                                        VerticalOffset="-10"
                                        IsOpen="False">
                                        <Calendar x:Name="Calendar" SelectionMode="SingleDate" SelectedDatesChanged="Calendar_OnSelectedDatesChanged"/>
                                </Popup>
                        </Grid>
                </Grid>
                <!-- 消息浮层：叠加在主布局之上，不占用任何行空间；
                     底部留出的 Margin 由 ShowInfoBar 按按钮区实际高度设置 -->
                <StackPanel x:Name="InfoBarPanel"
                            Spacing="8"
                            MaxWidth="640"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <StackPanel.Styles>
                                <!-- 消息出现时自上而下渐显，RenderTransform 由 ShowInfoBar 设置为 TranslateTransform -->
                                <Style Selector="fa|FAInfoBar">
                                        <Style.Animations>
                                                <Animation Duration="0:0:0.25" Easing="CubicEaseOut" FillMode="Forward">
                                                        <KeyFrame Cue="0%">
                                                                <Setter Property="Opacity" Value="0"/>
                                                                <Setter Property="TranslateTransform.Y" Value="-12"/>
                                                        </KeyFrame>
                                                        <KeyFrame Cue="100%">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="TranslateTransform.Y" Value="0"/>
                                                        </KeyFrame>
                                                </Animation>
                                        </Style.Animations>
                                </Style>
                        </StackPanel.Styles>
                </StackPanel>
                </Grid>
                <!-- 主抽屉（只有主抽屉，没有副抽屉）：
                     打开 = Opened，占窗口高度的 50%；
                     关闭 = Closed，整个面板移到画布下方。
                     点击外部或按 Esc 直接关闭抽屉。 -->
                <Panel x:Name="MainDrawerRoot" Grid.RowSpan="2" ZIndex="100" IsHitTestVisible="False">
                        <!-- 透明命中层：抽屉打开时拦截外部点击并关闭抽屉；
                             主抽屉不显示烟雾遮罩。 -->
                        <Border x:Name="MainDrawerDismissLayer"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                PointerPressed="MainDrawerDismissLayer_OnPointerPressed"/>
                        <!-- 抽屉从窗口底边滑出，层级高于底部按钮栏 -->
                        <Canvas x:Name="MainDrawerCanvas"
                                ClipToBounds="True"
                                SizeChanged="MainDrawerCanvas_OnSizeChanged">
                                <Panel x:Name="MainDrawerPanel"
                                       Width="{Binding Bounds.Width, ElementName=MainDrawerCanvas}"
                                       Height="0"
                                       Canvas.Bottom="-100000">
                                        <Panel.Transitions>
                                                <Transitions>
                                                        <DoubleTransition Property="Canvas.Bottom" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                                                        <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                                                </Transitions>
                                        </Panel.Transitions>
                                        <Border x:Name="MainDrawerBackground"
                                                Width="960"
                                                MaxWidth="{Binding Bounds.Width, ElementName=MainDrawerCanvas}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"
                                                Background="{DynamicResource ContentDialogBackground}"
                                                BorderBrush="{DynamicResource ContentDialogBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8 8 0 0"
                                                BoxShadow="0 8 32 0 #66000000">
                                                <Border ClipToBounds="True" CornerRadius="8 8 0 0" Padding="8 8 8 0">
                                                        <Grid RowDefinitions="32,*" ColumnDefinitions="*,Auto">
                                                                <TextBlock x:Name="MainDrawerTitle"
                                                                           Grid.Row="0" Grid.Column="0"
                                                                           VerticalAlignment="Center"
                                                                           FontSize="16" FontWeight="SemiBold"
                                                                           Text="作业编辑"/>
                                                                <StackPanel Grid.Row="0" Grid.Column="1"
                                                                            Orientation="Horizontal" Spacing="4">
                                                                        <Button x:Name="MainDrawerCloseButton"
                                                                                Theme="{StaticResource TransparentButton}"
                                                                                Width="32" Height="32"
                                                                                ToolTip.Tip="关闭"
                                                                                Click="MainDrawerCloseButton_OnClick">
                                                                                <fa:FASymbolIcon Symbol="Dismiss" FontSize="14"/>
                                                                        </Button>
                                                                </StackPanel>
                                                                <ContentControl x:Name="MainDrawerContent"
                                                                                Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                                HorizontalContentAlignment="Stretch"
                                                                                VerticalContentAlignment="Stretch">
                                                                        <ScrollViewer x:Name="MainDrawerScrollViewer"
                                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                                      VerticalScrollBarVisibility="Auto">
                                                                                <controls:HomeworkEditView x:Name="MainDrawerEditView"/>
                                                                        </ScrollViewer>
                                                                </ContentControl>
                                                        </Grid>
                                                </Border>
                                        </Border>
                                </Panel>
                        </Canvas>
                </Panel>
                <!-- 时光机：点击还原按钮后从窗口底部上浮。
                     打开时拦截外部点击并关闭；按 Esc 也会关闭。 -->
                <Panel x:Name="TimeMachineRoot" Grid.RowSpan="2" ZIndex="110" IsHitTestVisible="False">
                        <Border x:Name="TimeMachineDismissLayer"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                PointerPressed="TimeMachineDismissLayer_OnPointerPressed"/>
                        <Canvas x:Name="TimeMachineCanvas"
                                ClipToBounds="True"
                                SizeChanged="TimeMachineCanvas_OnSizeChanged">
                                <Panel x:Name="TimeMachinePanel"
                                       Width="{Binding Bounds.Width, ElementName=TimeMachineCanvas}"
                                       Height="0"
                                       Canvas.Bottom="0">
                                        <Border x:Name="TimeMachineBackground"
                                                Width="960"
                                                MaxWidth="{Binding Bounds.Width, ElementName=TimeMachineCanvas}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Stretch"
                                                Background="{DynamicResource ContentDialogBackground}"
                                                BorderBrush="{DynamicResource ContentDialogBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8 8 0 0"
                                                BoxShadow="0 8 32 0 #66000000">
                                                <Border ClipToBounds="True" CornerRadius="8 8 0 0" Padding="12,10">
                                                        <Grid RowDefinitions="32,*,Auto" RowSpacing="10">
                                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Spacing="8"
                                                                                    VerticalAlignment="Center">
                                                                                <fa:FASymbolIcon Symbol="Clock"
                                                                                                 FontSize="18"
                                                                                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                                                <TextBlock Text="时光机"
                                                                                           FontSize="16"
                                                                                           FontWeight="SemiBold"
                                                                                           VerticalAlignment="Center"/>
                                                                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                                                        CornerRadius="8"
                                                                                        Padding="8,2"
                                                                                        VerticalAlignment="Center">
                                                                                        <TextBlock x:Name="TimeMachineSubtitle"
                                                                                                   FontSize="12"
                                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                </Border>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1"
                                                                                x:Name="TimeMachineCloseButton"
                                                                                Theme="{StaticResource TransparentButton}"
                                                                                Width="32" Height="32"
                                                                                ToolTip.Tip="关闭"
                                                                                Click="TimeMachineCloseButton_OnClick">
                                                                                <fa:FASymbolIcon Symbol="Dismiss" FontSize="14"/>
                                                                        </Button>
                                                                </Grid>
                                                                <Border Grid.Row="1"
                                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="8"
                                                                        Padding="12,8">
                                                                        <Grid RowDefinitions="Auto,*" RowSpacing="4">
                                                                                <TextBlock Text="左右滑动选择时间点，越靠右的快照越新"
                                                                                           FontSize="12"
                                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                                <controls:HomeworkTimeMachine x:Name="TimeMachine"
                                                                                                              Grid.Row="1"
                                                                                                              SelectedSnapshotChanged="TimeMachine_OnSelectedSnapshotChanged"/>
                                                                        </Grid>
                                                                </Border>
                                                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                                        <TextBlock x:Name="TimeMachineSelectionText"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <StackPanel Grid.Column="1"
                                                                                    Orientation="Horizontal"
                                                                                    Spacing="8">
                                                                                <Button x:Name="TimeMachineMergeButton"
                                                                                        Content="合并"
                                                                                        Click="TimeMachineMergeButton_OnClick"/>
                                                                                <Button x:Name="TimeMachineReplaceButton"
                                                                                        Content="替换"
                                                                                        Classes="accent"
                                                                                        Click="TimeMachineReplaceButton_OnClick"/>
                                                                                <Button Content="取消"
                                                                                        Theme="{StaticResource TransparentButton}"
                                                                                        Click="TimeMachineCloseButton_OnClick"/>
                                                                        </StackPanel>
                                                                </Grid>
                                                        </Grid>
                                                </Border>
                                        </Border>
                                </Panel>
                        </Canvas>
                </Panel>
        </Grid>
</Window>
