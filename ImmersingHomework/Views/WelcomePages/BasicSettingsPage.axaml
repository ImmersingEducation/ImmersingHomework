<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImmersingHomework.Views.WelcomePages.BasicSettingsPage">
    <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
        <fa:FASettingsExpander Header="开机自启动" Description="在计算机开机后自动启动本软件。">
            <fa:FASettingsExpander.IconSource>
                <fa:FASymbolIconSource Symbol="Star"/>
            </fa:FASettingsExpander.IconSource>
            <fa:FASettingsExpander.Footer>
                <ToggleSwitch x:Name="LaunchAtStartupSwitch" OnContent="" OffContent="" IsCheckedChanged="LaunchAtStartupSwitch_OnIsCheckedChanged"/>
            </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>
        <fa:FASettingsExpander x:Name="UrlSchemaRegisteredExpander" Header="注册 URL 协议" Description="允许通过链接（immersinghomework://）唤起本软件。">
            <fa:FASettingsExpander.IconSource>
                <fa:FASymbolIconSource Symbol="Link"/>
            </fa:FASettingsExpander.IconSource>
            <fa:FASettingsExpander.Footer>
                <ToggleSwitch x:Name="UrlSchemaRegisteredSwitch" OnContent="" OffContent="" IsCheckedChanged="UrlSchemaRegisteredSwitch_OnIsCheckedChanged"/>
            </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>
        <fa:FASettingsExpander x:Name="FloatingWindowSideExpander" Header="浮窗位置" Description="选择浮窗显示在屏幕左侧还是右侧。">
            <fa:FASettingsExpander.IconSource>
                <fa:FASymbolIconSource Symbol="Pin"/>
            </fa:FASettingsExpander.IconSource>
            <fa:FASettingsExpander.Footer>
                <fa:FAComboBox x:Name="FloatingWindowSideComboBox"
                               SelectionChanged="FloatingWindowSideComboBox_OnSelectionChanged">
                    <fa:FAComboBoxItem Content="靠左"/>
                    <fa:FAComboBoxItem Content="靠右"/>
                </fa:FAComboBox>
            </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>
        <fa:FASettingsExpander Header="主题色" Description="设置软件的强调色，按钮、开关与选中态都会使用该颜色。">
            <fa:FASettingsExpander.IconSource>
                <fa:FASymbolIconSource Symbol="ColorBackgroundFilled"/>
            </fa:FASettingsExpander.IconSource>
            <fa:FASettingsExpander.Footer>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border x:Name="ThemeAccentColorPreview"
                            Width="32" Height="32" CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                    <ColorPicker x:Name="ThemeAccentColorPicker"
                                 ColorChanged="ThemeAccentColorPicker_OnColorChanged"/>
                </StackPanel>
            </fa:FASettingsExpander.Footer>
        </fa:FASettingsExpander>
    </StackPanel>
</UserControl>
