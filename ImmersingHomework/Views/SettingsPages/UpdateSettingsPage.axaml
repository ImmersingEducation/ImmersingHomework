<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImmersingHomework.Views.SettingsPages.UpdateSettingsPage">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="8" Margin="12 12 12 0">
            <TextBlock Text="更新设置" FontSize="36" FontWeight="Bold"/>
            <TextBlock Text="管理更新行为。" FontSize="18"/>
            <fa:FASettingsExpander Header="更新系统状态" IsExpanded="True">
                <fa:FASettingsExpander.IconSource>
                    <fa:FASymbolIconSource Symbol="Sync"/>
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckUpdateButton" Click="CheckUpdateButton_OnClick">检查更新</Button>
                        <Button x:Name="DownloadButton" IsVisible="False" Click="DownloadButton_OnClick">下载</Button>
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
                <fa:FASettingsExpanderItem x:Name="UpdateStatusItem">
                    <fa:FASettingsExpanderItem.Footer>
                        <ProgressBar x:Name="UpdateProgressBar" Width="220" IsVisible="False"/>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="更新渠道" Description="选择从哪个渠道接收更新。">
                <fa:FASettingsExpander.IconSource>
                    <fa:FASymbolIconSource Symbol="Globe"/>
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                    <fa:FAComboBox x:Name="UpdateChannelComboBox"
                                   SelectionChanged="UpdateChannelComboBox_OnSelectionChanged">
                        <fa:FAComboBoxItem Content="稳定版"/>
                        <fa:FAComboBoxItem Content="测试版"/>
                    </fa:FAComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="更新行为" Description="发现更新后的默认处理方式。">
                <fa:FASettingsExpander.IconSource>
                    <fa:FASymbolIconSource Symbol="Download"/>
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                    <fa:FAComboBox x:Name="UpdateCheckBehaviorComboBox"
                                   SelectionChanged="UpdateCheckBehaviorComboBox_OnSelectionChanged">
                        <fa:FAComboBoxItem Content="立即安装"/>
                        <fa:FAComboBoxItem Content="立即下载"/>
                        <fa:FAComboBoxItem Content="立即通知"/>
                        <fa:FAComboBoxItem Content="不执行任何操作"/>
                    </fa:FAComboBox>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
