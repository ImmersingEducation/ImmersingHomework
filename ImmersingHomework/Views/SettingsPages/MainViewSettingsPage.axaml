<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImmersingHomework.Views.SettingsPages.MainViewSettingsPage">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="8" Margin="12 12 12 0">
            <TextBlock Text="主界面设置" FontSize="36" FontWeight="Bold"/>
            <TextBlock Text="设置主界面外观与行为。" FontSize="18"/>
            <fa:FASettingsExpander Header="主界面列数" Description="主界面作业分隔显示的列数。">
                <fa:FASettingsExpander.IconSource>
                    <fa:FASymbolIconSource Symbol="Pause"></fa:FASymbolIconSource>
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                    <NumericUpDown x:Name="MainViewColumnNumericUpDown" Minimum="1" Maximum="6" Increment="1"
                                   FormatString="0" ClipValueToMinMax="True"
                                   ValueChanged="MainViewColumnNumericUpDown_OnValueChanged"></NumericUpDown>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="主界面背景图片" Description="选择一张图片作为主界面背景。">
                <fa:FASettingsExpander.IconSource>
                    <fa:FASymbolIconSource Symbol="Image"></fa:FASymbolIconSource>
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="BackgroundImageStatusTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="SelectBackgroundImageButton" Click="SelectBackgroundImageButton_OnClick">选择图片</Button>
                        <Button x:Name="ClearBackgroundImageButton" Click="ClearBackgroundImageButton_OnClick">移除</Button>
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="背景图片透明度" Description="调整主界面背景图片的显示透明度。">
                <fa:FASettingsExpander.IconSource>
                    <fa:FASymbolIconSource Symbol="ImageEdit"></fa:FASymbolIconSource>
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Slider x:Name="BackgroundImageOpacitySlider"
                                Width="220"
                                Minimum="0" Maximum="100"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                ValueChanged="BackgroundImageOpacitySlider_OnValueChanged"/>
                        <TextBlock x:Name="BackgroundImageOpacityTextBlock"
                                   Width="48"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
