<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImmersingHomework.Views.SettingsPages.BackupSettingsPage">
    <ScrollViewer>
        <StackPanel Orientation="Vertical" Spacing="8" Margin="12 12 12 0">
            <TextBlock Text="备份设置" FontSize="36" FontWeight="Bold"/>
            <TextBlock Text="管理备份、恢复、迁移行为。" FontSize="18"/>
            <fa:FASettingsExpander Header="开始备份 / 向外迁移" Description="请确保备份 / 迁移环境">
                <fa:FASettingsExpander.IconSource>
                    <fa:FASymbolIconSource Symbol="ChevronUp"/>
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                    <Button x:Name="BackupButton" Click="BackupButton_OnClick">开始</Button>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
            <fa:FASettingsExpander Header="开始恢复 / 向内迁移" Description="请确保备份 / 迁移文件已准备好。">
                <fa:FASettingsExpander.IconSource>
                    <fa:FASymbolIconSource Symbol="ChevronDown"/>
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                    <Button x:Name="RestoreButton" Click="RestoreButton_OnClick">开始</Button>
                </fa:FASettingsExpander.Footer>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
