<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="36" d:DesignHeight="108"
        x:Class="ImmersingHomework.Views.FloatingButtonWindow"
        Title="作业板"
        Width="36"
        Height="108"
        CanResize="False"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual"
        WindowState="Normal"
        Focusable="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        Icon="avares://ImmersingHomework/Assets/icon.png">
    <Border CornerRadius="12"
            Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="2" Opacity="0.8"
            Cursor="Hand">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="1">
            <TextBlock Text="作"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="业"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="板"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </StackPanel>
    </Border>
</Window>
