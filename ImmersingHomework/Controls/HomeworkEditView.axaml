<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:ImmersingHomework.Controls"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImmersingHomework.Controls.HomeworkEditView">
    <UserControl.Styles>
        <Style Selector="Border.editor-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="Border.icon-chip">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.card-hint">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="0,4,0,12" Spacing="10">
        <Border Classes="editor-card">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="icon-chip">
                        <fa:FASymbolIcon Symbol="Library"
                                         FontSize="15"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Classes="card-title" Text="科目"/>
                        <TextBlock Classes="card-hint" Text="左右滑动或点击两侧科目切换"/>
                    </StackPanel>
                </Grid>

                <controls:SubjectWheel x:Name="SubjectWheel"
                                       SelectedSubjectChanged="SubjectWheel_OnSelectedSubjectChanged"/>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="280,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="12">
                <Border Classes="editor-card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="icon-chip">
                                <fa:FASymbolIcon Symbol="Tag"
                                                 FontSize="15"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Classes="card-title" Text="标签"/>
                                <TextBlock Classes="card-hint" Text="可多选，标签会显示在作业列表中"/>
                            </StackPanel>
                        </Grid>

                        <controls:TagPicker x:Name="TagPicker"/>

                        <TextBlock x:Name="NoTagsText"
                                   Classes="card-hint"
                                   Text="还没有标签，可在“设置 → 标签设置”中添加。"
                                   IsVisible="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Classes="editor-card">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Classes="icon-chip">
                            <fa:FASymbolIcon Symbol="Document"
                                             FontSize="15"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Classes="card-title" Text="作业内容"/>
                            <TextBlock Classes="card-hint" Text="输入作业要求，或选择模板快速生成内容"/>
                        </StackPanel>
                        <TextBlock x:Name="ContentCountText"
                                   Grid.Column="2"
                                   Classes="card-hint"
                                   Text="0 字"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <controls:HomeworkContentInput x:Name="ContentInput"/>
                </StackPanel>
            </Border>
        </Grid>

        <fa:FAInfoBar x:Name="ValidationBar"
                      Severity="Error"
                      IsClosable="False"
                      IsOpen="False"/>

        <Border BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Padding="2,10,2,0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button x:Name="DeleteButton"
                        Theme="{StaticResource TransparentButton}"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Padding="10,6"
                        HorizontalAlignment="Left"
                        IsVisible="False"
                        Click="DeleteButton_OnClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fa:FASymbolIcon Symbol="Delete" FontSize="14"/>
                        <TextBlock Text="删除这条作业"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <fa:FASymbolIcon Symbol="Save"
                                     FontSize="14"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Spacing="1">
                        <TextBlock Text="关闭抽屉时自动保存"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="需填写科目和内容"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
