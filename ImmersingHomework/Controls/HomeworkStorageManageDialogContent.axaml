<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImmersingHomework.Controls.HomeworkStorageManageDialogContent">
    <StackPanel Orientation="Vertical" Spacing="8">
        <TextBlock HorizontalAlignment="Center">请选择一个日期，软件将会删除该日期及以前的作业信息以及所有为空的作业信息</TextBlock>
        <CalendarDatePicker x:Name="CalendarDatePicker" SelectedDateChanged="CalendarDatePicker_OnSelectedDateChanged" Width="200" HorizontalAlignment="Center"/>
        <TextBlock x:Name="WarningTextBlock" Foreground="DarkRed" HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
