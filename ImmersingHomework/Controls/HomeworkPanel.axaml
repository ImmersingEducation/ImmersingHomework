<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImmersingHomework.Controls.HomeworkPanel">
    <Grid>
        <ScrollViewer x:Name="HomeworkScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      AllowAutoHide="True">
            <Grid x:Name="HomeworkGrid" RowSpacing="32" ColumnSpacing="32"/>
        </ScrollViewer>
        <TextBlock x:Name="NoHomeworkText" Text="今天没有作业，休息一下吧！" 
                   FontSize="24" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   IsVisible="False"/>
        <!-- 拖拽时的浮层：承载跟随指针的卡片和插入位置分隔线。 -->
        <Canvas x:Name="DragOverlay"
                ZIndex="30"
                ClipToBounds="True"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>
