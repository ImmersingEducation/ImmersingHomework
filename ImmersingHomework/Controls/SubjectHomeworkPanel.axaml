<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImmersingHomework.Controls.SubjectHomeworkPanel">
    <StackPanel Orientation="Vertical" Spacing="16" Width="320">
        <TextBlock x:Name="SubjectText" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
        <StackPanel x:Name="HomeworkItemPanels" Orientation="Vertical" Spacing="12" />
    </StackPanel>
</UserControl>
