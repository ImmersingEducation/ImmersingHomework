<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ImmersingHomework.App"
             xmlns:fa="clr-namespace:FluentAvalonia.Styling;assembly=FluentAvalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <!-- 应用默认字体（复合字体），需与 Program.DefaultFontFamilyKey 保持一致。
             Avalonia 按顺序在各个字体里找字形：正文用 HarmonyOS Sans SC，
             PUA 区的图标字形（汉堡菜单 E700、返回 E72B、搜索 E11A、标题栏按钮 E738/E739/E711 等）
             由第二项 FluentAvalonia 自带的 Symbols 字体提供，不需要额外内置字体文件。
             注意：下面 Button/TextBlock 全局样式的优先级高于 ControlTheme，会覆盖 Fluent 主题
             在控件模板里设的图标字体（如 NavigationView 的 PaneToggleButtonStyle），
             所以图标字体必须写在这里，而不是指望系统字体回退兜底。 -->
        <FontFamily x:Key="AppFontFamily">avares://ImmersingHomework/Assets/Fonts/HarmonyOS_SansSC_Regular.ttf#HarmonyOS Sans SC, avares://FluentAvalonia/Fonts#Symbols</FontFamily>

        <!-- Fluent 主题的弹出层/列表等模板通过 DynamicResource 取此键；
             此前未定义，弹出层会退回系统默认字体，这里统一指向上面的字体 -->
        <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="AppFontFamily"/>
    </Application.Resources>

    <Application.Styles>
        <fa:FluentAvaloniaTheme />
        
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        </Style>
        <!-- 标题栏系统按钮(最小化/最大化/关闭)：AppFontFamily 已是复合字体，这条改为显式指定，
             属于冗余保险(不依赖复合字体的解析顺序)，只影响这几个按钮。 -->
        <Style Selector="Button.CaptionButton">
            <Setter Property="FontFamily" Value="avares://FluentAvalonia/Fonts#Symbols" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        </Style>
    </Application.Styles>
             
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://ImmersingHomework/Assets/icon.png">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="显示主窗口"/>
                        <NativeMenuItem Header="显示/隐藏浮窗"/>
                        <NativeMenuItem Header="打开设置窗口"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="重启"/>
                        <NativeMenuItem Header="退出"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>